.{
    .name = .random123,
    // Upstream release version.
    .version = "1.14.0",
    .minimum_zig_version = "0.16.0",
    // Package-specific fingerprint.
    .fingerprint = 0xc9d650ae8c9fc996,

    // Vendored source; no network dependency.
    .dependencies = .{},

    // Required package files; missing `.paths` entries fail resolution.
    .paths = .{
        // Build graph and fork-owned source.
        "build.zig",
        "build.zig.zon",
        "root.zig",
        "zig",
        // Runtime dispatch modules.
        "runtime",
        // Consumer example package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Unmodified upstream source and fixtures.
        "include",
        "tests",
        "examples",
        "docs",
        "GNUmakefile",
        // Upstream licence and fork records.
        "LICENSE",
        "README.md",
        "README.upstream.md",
        "README.zig.md",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        // Nix/devenv packaging and lock inputs.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        "flake.lock",
        // Cross-test profile.
        "cross-test.profile.sh",
        ".gitignore",
    },
}
